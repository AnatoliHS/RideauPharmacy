<style>
  :root {
    --anim--hover-time: 400ms;
    --anim--hover-ease: cubic-bezier(0.25, 1, 0.5, 1);
    --line-color: #f44336;
  }

  /* --- NAVBAR CONTAINER --- */
  .navbar {
    position: sticky;
    top: 0;
    display: flex;
    justify-content: flex-start;
    gap: 20px;
    align-items: center;
    padding: 15px 20px;
    width: 100%;
    box-sizing: border-box;
    z-index: 100;
    background: white;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    transition: background 0.3s ease, box-shadow 0.3s ease, padding 0.3s ease;
  }

  .nav-logo img {
    height: 40px;
    width: auto;
    display: block;
    transition: filter 0.3s ease;
  }

  /* --- RESTORED HAMBURGER ANIMATION --- */
  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
    cursor: pointer;
    z-index: 101;
    flex-shrink: 0;
  }

  .hamburger span {
    display: block;
    height: 2px;
    width: 100%;
    background: #333;
    border-radius: 2px;
    transition: all 0.3s ease;
    transform-origin: left center;
    /* Critical for your original animation */
  }

  /* Your original "X" logic */
  .navbar.open .hamburger span:nth-child(1) {
    transform: rotate(45deg) translate(0px, -2px);
  }

  .navbar.open .hamburger span:nth-child(2) {
    opacity: 0;
    width: 0;
  }

  .navbar.open .hamburger span:nth-child(3) {
    transform: rotate(-45deg) translate(0px, 2px);
  }

  /* --- NAV LINKS DROPDOWN --- */
  .navbar-links {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: white;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    max-height: 0;
    opacity: 0;
    transition: max-height 0.4s ease, opacity 0.3s ease;
    display: flex;
    flex-direction: column;
    z-index: 99;
    overflow: hidden;
    border-radius: 0 0 25px 25px;
    margin-top: -1px;
  }

  .navbar.open .navbar-links {
    max-height: 500px;
    opacity: 1;
    padding-bottom: 20px;
  }

  /* --- NAV LINK STYLES --- */
  .nav-link {
    text-decoration: none;
    color: #333;
    font-size: 35px;
    font-family: 'Teodor', serif;
    font-weight: 400;
    padding: 15px 40px;
    display: block;
    width: fit-content;
    position: relative;
    opacity: 0;
    transform: translateX(-100%);
    transition: transform 0.5s var(--anim--hover-ease), opacity 0.5s ease, color 0.3s ease;
  }

  .nav-link::before,
  .nav-link::after {
    content: '';
    width: 0%;
    height: 2px;
    background: var(--line-color);
    display: block;
    transition: 0.5s;
  }

  .nav-link::before {
    margin-left: auto;
  }

  .nav-link::after {
    margin-top: 4px;
  }

  .nav-link:hover::after,
  .nav-link:hover::before {
    width: 100%;
  }

  .navbar.open .nav-link {
    opacity: 1;
    transform: translateX(0);
  }

  /* --- DESKTOP REFACTOR --- */
  @media (min-width: 1025px) {
    .hamburger {
      display: none;
    }

    .navbar {
      justify-content: flex-start;
      gap: 40px;
      padding: 15px 5%;
    }

    .navbar-links {
      position: static;
      max-height: none;
      opacity: 1;
      flex-direction: row;
      background: transparent;
      box-shadow: none;
      width: auto;
      overflow: visible;
      gap: 30px;
    }

    .nav-link {
      font-size: 1.3rem;
      padding: 5px 0;
      opacity: 1;
      transform: none;
      color: #191f4f;
      font-weight: 500;
    }

    /* Stagger Delays - Disable for desktop static view */
    .nav-link:nth-child(n) {
      transition-delay: 0s !important;
    }
  }

  /* Stagger Delays (Mobile Only) */
  @media (max-width: 1024px) {
    .navbar.open .nav-link:nth-child(1) {
      transition-delay: 0.1s;
    }

    .navbar.open .nav-link:nth-child(2) {
      transition-delay: 0.2s;
    }

    .navbar.open .nav-link:nth-child(3) {
      transition-delay: 0.3s;
    }

    .navbar.open .nav-link:nth-child(4) {
      transition-delay: 0.4s;
    }
  }

  /* --- TRANSPARENT NAVBAR OVERLAY FOR HERO SECTIONS --- */
  .navbar.transparent-nav:not(.scrolled):not(.open) {
    background: transparent;
    box-shadow: none;
  }

  .navbar.transparent-nav:not(.scrolled):not(.open) .hamburger span {
    background: #ffffff;
  }

  .navbar.transparent-nav:not(.scrolled):not(.open) .nav-logo img {
    filter: brightness(0) invert(1);
  }

  /* Pull hero section up behind the sticky transparent navbar */
  body.has-hero .hero-section {
    margin-top: calc(-1 * var(--navbar-height, 70px));
  }

  @media (min-width: 1025px) {
    .navbar.transparent-nav:not(.scrolled):not(.open) .nav-link {
      color: rgba(255, 255, 255, 0.95);
    }

    .navbar.transparent-nav:not(.scrolled):not(.open) .nav-link:hover {
      color: #ffffff;
    }

    .navbar.transparent-nav:not(.scrolled):not(.open) .book-appointment-btn {
      background: transparent;
      border-color: rgba(255, 255, 255, 0.85);
      color: white;
    }

    .navbar.transparent-nav:not(.scrolled):not(.open) .book-appointment-btn:hover {
      background: rgba(255, 255, 255, 0.15);
      border-color: #ffffff;
      color: #ffffff;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(255, 255, 255, 0.25);
    }
  }

  /* --- BOOK APPOINTMENT BUTTON --- */
  .book-appointment-btn {
    margin-left: auto;
    background: #191f4f;
    color: white;
    text-decoration: none;
    padding: 10px 25px;
    border-radius: 50px;
    font-family: 'Teodor', serif;
    font-weight: 600;
    font-size: 1.15rem;
    transition: all 0.3s ease, background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
    white-space: nowrap;
    z-index: 102;
    border: 2px solid transparent;
  }

  .book-appointment-btn:hover {
    background: #588cba;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(88, 140, 186, 0.3);
  }

  @media (max-width: 1024px) {
    .book-appointment-btn {
      position: fixed;
      bottom: 20px;
      right: 20px;
      margin-left: 0;
      padding: 10px 20px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
      font-size: 1.1rem;
    }
  }
</style>

<nav class="navbar">
  <div class="hamburger"><span></span><span></span><span></span></div>
  <a href="/" class="nav-logo" onclick="handleNavigation(event, '/')">
    <img src="/assets/rideau-Logo.png" alt="Logo">
  </a>
  <div class="navbar-links">
    <a href="/" class="nav-link" onclick="handleNavigation(event, '/')">Home</a>
    <a href="#about-section" class="nav-link" onclick="handleNavigation(event, '#about-section')">About</a>
    <a href="#services-section" class="nav-link" onclick="handleNavigation(event, '#services-section')">Services</a>
    <a href="#faq-section" class="nav-link" onclick="handleNavigation(event, '#faq-section')">FAQ</a>
    <a href="#contact-section" class="nav-link" onclick="handleNavigation(event, '#contact-section')">Contact</a>
  </div>
  <a href="#booking-section" class="book-appointment-btn">Book Appointment</a>
</nav>

<script>
  const hamburger = document.querySelector('.hamburger');
  const navbar = document.querySelector('.navbar');
  hamburger.addEventListener('click', () => { navbar.classList.toggle('open'); });

  // All DOM-dependent init — run after DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    // Initialize transparent navbar if page contains a hero section
    const heroSection = document.querySelector('.hero-section');
    if (heroSection) {
      navbar.classList.add('transparent-nav');
      document.body.classList.add('has-hero');

      // Store navbar height as a CSS variable for the negative margin trick
      const navHeight = navbar.getBoundingClientRect().height;
      document.documentElement.style.setProperty('--navbar-height', navHeight + 'px');
    }

    // Handle scroll trigger for transparent navbar transitions
    function handleNavbarScroll() {
      if (navbar.classList.contains('transparent-nav')) {
        if (window.scrollY > 50) {
          navbar.classList.add('scrolled');
        } else {
          navbar.classList.remove('scrolled');
        }
      }
    }
    window.addEventListener('scroll', handleNavbarScroll, { passive: true });
    handleNavbarScroll(); // Run immediately in case of page refresh while scrolled
  });

  function handleNavigation(event, url) {
    event.preventDefault();
    navbar.classList.remove('open'); // Close the mobile menu after selection

    const link = event.currentTarget;
    link.style.opacity = "0.7";

    setTimeout(() => {
      link.style.opacity = "1";
      if (url.startsWith('#')) {
        const target = document.querySelector(url);
        if (target) {
          // Calculate if we need a custom offset for the sticky header
          const headerOffset = 100;
          const elementPosition = target.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

          window.scrollTo({
            top: offsetPosition,
            behavior: "smooth"
          });
        }
      } else {
        window.location.href = url;
      }
    }, 500); // Increased delay to allow mobile menu to fully close (400ms transition)
  }

  // Adjust mobile floating button position to prevent overlapping footer
  window.addEventListener('scroll', function () {
    if (window.innerWidth <= 1024) {
      const btn = document.querySelector('.book-appointment-btn');
      const footer = document.querySelector('.whmis-footer');

      if (btn && footer) {
        const footerRect = footer.getBoundingClientRect();
        const windowHeight = window.innerHeight;

        // If the top of the footer is coming into view
        if (footerRect.top < windowHeight) {
          // Push the button up so it stays above the footer
          const visibleFooterHeight = windowHeight - footerRect.top;
          btn.style.bottom = (20 + visibleFooterHeight) + 'px';
        } else {
          btn.style.bottom = '20px';
        }
      }
    } else {
      const btn = document.querySelector('.book-appointment-btn');
      if (btn) btn.style.bottom = '';
    }
  });
</script>