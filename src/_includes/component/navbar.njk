<style>
  :root {
    --nav-h: 76px;
  }

  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    color: var(--ink);
    background: rgba(246, 242, 234, 0.92);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    transition: background-color 0.6s var(--ease), color 0.6s var(--ease);
  }

  .site-nav.is-overlay:not(.is-solid) {
    color: var(--on-dark);
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .site-nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: var(--nav-h);
  }

  .nav-brand {
    justify-self: start;
    color: inherit;
    font-family: var(--font-serif);
    font-size: 1.65rem;
    line-height: 1;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .nav-brand small {
    display: block;
    margin-top: 4px;
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .site-nav-links {
    display: flex;
    gap: 32px;
  }

  .site-nav-links a {
    color: inherit;
    font-size: 0.92rem;
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.3s ease;
  }

  .site-nav-links a:hover {
    opacity: 1;
  }

  .site-nav-end {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 18px;
  }

  .site-nav-cta {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 20px;
    border: 1px solid currentColor;
    border-radius: 999px;
    color: inherit;
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.4s var(--ease), color 0.4s var(--ease), border-color 0.4s var(--ease);
  }

  .site-nav-cta:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--ivory);
  }

  .site-nav.is-overlay:not(.is-solid) .site-nav-cta:hover {
    background: var(--on-dark);
    border-color: var(--on-dark);
    color: var(--forest);
  }

  .site-nav-toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.92rem;
    cursor: pointer;
  }

  .site-nav-toggle span {
    display: grid;
    gap: 5px;
  }

  .site-nav-toggle i {
    display: block;
    width: 22px;
    height: 1px;
    background: currentColor;
  }

  html.nav-locked {
    overflow: hidden;
  }

  /* Menu: a photo on one half, the links on a deep green panel on the other */
  .site-drawer {
    position: fixed;
    inset: 0;
    z-index: 110;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    background: var(--forest);
    color: var(--on-dark);
    visibility: hidden;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.9s var(--ease), visibility 0s linear 0.9s;
  }

  .site-drawer.is-open {
    visibility: visible;
    clip-path: inset(0 0 0 0);
    transition: clip-path 0.9s var(--ease), visibility 0s;
  }

  .site-drawer-img {
    background: url('/web/aisle.webp') center / cover no-repeat;
  }

  .site-drawer-body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    min-width: 0;
    padding: 24px var(--gutter) 36px;
    overflow-y: auto;
  }

  .site-drawer-close {
    align-self: flex-end;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .site-drawer nav {
    display: grid;
    gap: 4px;
  }

  .site-drawer nav a {
    color: inherit;
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4.6vw, 3.8rem);
    line-height: 1.12;
    text-decoration: none;
    transition: color 0.4s ease, padding 0.6s var(--ease);
  }

  .site-drawer nav a:hover {
    color: var(--gold-light);
    padding-left: 14px;
  }

  .site-drawer-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    color: var(--on-dark-muted);
    font-size: 0.92rem;
  }

  .site-drawer-foot a {
    color: inherit;
    text-decoration: none;
  }

  .site-drawer-foot a:hover {
    color: var(--gold-light);
  }

  @media (max-width: 1000px) {
    .site-nav-inner {
      grid-template-columns: 1fr auto;
    }

    .site-nav-links {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .site-nav-cta {
      display: none;
    }

    .site-drawer {
      grid-template-columns: minmax(0, 1fr);
    }

    .site-drawer-img {
      display: none;
    }
  }
</style>

<nav class="site-nav{% if navOverlay %} is-overlay{% endif %}" aria-label="Main">
  <div class="wrap site-nav-inner">
    <a href="/" class="nav-brand" aria-label="{{ site.name }}, home">Bellfront<small>{{ site.banner }} Pharmacy</small></a>
    <div class="site-nav-links">
      <a href="/#services">Services</a>
      <a href="/#pharmacist">Your pharmacist</a>
      <a href="/#faq">Questions</a>
      <a href="/#visit">Visit</a>
    </div>
    <div class="site-nav-end">
      <a href="/#booking" class="site-nav-cta">Book appointment</a>
      <button class="site-nav-toggle" type="button" aria-expanded="false" aria-controls="site-drawer">Menu <span aria-hidden="true"><i></i><i></i></span></button>
    </div>
  </div>
</nav>

<div class="site-drawer" id="site-drawer" inert>
  <div class="site-drawer-img" aria-hidden="true"></div>
  <div class="site-drawer-body">
    <button class="site-drawer-close" type="button">Close ✕</button>
    <nav aria-label="Menu">
      <a href="/#services">Services</a>
      <a href="/#pharmacist">Your pharmacist</a>
      <a href="/#booking">Book an appointment</a>
      <a href="{{ site.refillUrl }}" target="_blank" rel="noopener">Refill a prescription</a>
      <a href="/#faq">Questions</a>
      <a href="/#visit">Hours &amp; directions</a>
    </nav>
    <div class="site-drawer-foot">
      <span>{{ site.address.street }}, {{ site.address.city }}</span>
      <a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a>
      <a href="{{ site.transferUrl }}" target="_blank" rel="noopener">Transfer a prescription</a>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.documentElement;
    var nav = document.querySelector('.site-nav');
    var toggle = document.querySelector('.site-nav-toggle');
    var drawer = document.getElementById('site-drawer');
    var closeBtn = drawer.querySelector('.site-drawer-close');
    var hours = {{ site.hours | dump | safe }};
    var DAY_NAMES = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    var DAY_KEYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

    function toMinutes(hhmm) {
      var parts = hhmm.split(':');
      return Number(parts[0]) * 60 + Number(parts[1]);
    }

    function toLabel(hhmm) {
      var minutes = toMinutes(hhmm);
      var hour = Math.floor(minutes / 60);
      return ((hour % 12) || 12) + ':' + String(minutes % 60).padStart(2, '0') + (hour >= 12 ? ' PM' : ' AM');
    }

    function hoursFor(day) {
      return hours.filter(function (row) {
        return row.days.indexOf(day) !== -1 && row.open;
      })[0];
    }

    // Open or closed right now, on the pharmacy's clock. Used by the home page.
    function readStatus() {
      var parts = {};
      new Intl.DateTimeFormat('en-CA', {
        timeZone: 'America/Toronto',
        weekday: 'short',
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23'
      }).formatToParts(new Date()).forEach(function (part) {
        parts[part.type] = part.value;
      });

      var today = DAY_KEYS.indexOf(parts.weekday.slice(0, 3));
      var now = Number(parts.hour) * 60 + Number(parts.minute);
      var current = hoursFor(today);

      if (current && now >= toMinutes(current.open) && now < toMinutes(current.close)) {
        return { today: today, state: 'open', label: 'Open now', detail: 'Until ' + toLabel(current.close) + ' today' };
      }

      var status = { today: today, state: 'closed', label: 'Closed now', detail: '' };
      if (current && now < toMinutes(current.open)) {
        status.detail = 'Opens today at ' + toLabel(current.open);
        return status;
      }
      for (var offset = 1; offset <= 7; offset++) {
        var day = (today + offset) % 7;
        var next = hoursFor(day);
        if (next) {
          status.detail = 'Opens ' + (offset === 1 ? 'tomorrow' : DAY_NAMES[day]) + ' at ' + toLabel(next.open);
          break;
        }
      }
      return status;
    }

    window.siteStatus = readStatus;

    // Over the home hero the bar stays clear; it turns solid once the hero has passed.
    function updateSolid() {
      var hero = nav.classList.contains('is-overlay') && document.querySelector('.hero');
      var limit = hero ? hero.offsetHeight - nav.offsetHeight : 40;
      nav.classList.toggle('is-solid', window.scrollY > limit);
    }

    function menuOpen() {
      return drawer.classList.contains('is-open');
    }

    function setOpen(open) {
      if (open === menuOpen()) return;
      drawer.classList.toggle('is-open', open);
      drawer.inert = !open;
      root.classList.toggle('nav-locked', open);
      toggle.setAttribute('aria-expanded', String(open));
      if (open) closeBtn.focus();
    }

    toggle.addEventListener('click', function () { setOpen(true); });
    closeBtn.addEventListener('click', function () {
      setOpen(false);
      toggle.focus();
    });
    drawer.addEventListener('click', function (event) {
      if (event.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && menuOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });
    window.addEventListener('scroll', updateSolid, { passive: true });
    window.addEventListener('resize', updateSolid);
    updateSolid();
    document.addEventListener('DOMContentLoaded', updateSolid);
  })();
</script>
