<style>
  :root {
    --anim--hover-time: 400ms;
    --anim--hover-ease: cubic-bezier(0.25, 1, 0.5, 1);
    --line-color: #f44336;
  }

  /* --- NAVBAR CONTAINER --- */
  .navbar {
    position: sticky;
    top: 0;
    display: flex;
    justify-content: flex-start;
    gap: 20px;
    align-items: center;
    padding: 15px 20px;
    width: 100%;
    box-sizing: border-box;
    z-index: 100;
    background: white;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .nav-logo img {
    height: 40px;
    width: auto;
    display: block;
  }

  /* --- RESTORED HAMBURGER ANIMATION --- */
  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
    cursor: pointer;
    z-index: 101;
    flex-shrink: 0;
  }

  .hamburger span {
    display: block;
    height: 2px;
    width: 100%;
    background: #333;
    border-radius: 2px;
    transition: all 0.3s ease;
    transform-origin: left center;
    /* Critical for your original animation */
  }

  /* Your original "X" logic */
  .navbar.open .hamburger span:nth-child(1) {
    transform: rotate(45deg) translate(0px, -2px);
  }

  .navbar.open .hamburger span:nth-child(2) {
    opacity: 0;
    width: 0;
  }

  .navbar.open .hamburger span:nth-child(3) {
    transform: rotate(-45deg) translate(0px, 2px);
  }

  /* --- NAV LINKS DROPDOWN --- */
  .navbar-links {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: white;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    max-height: 0;
    opacity: 0;
    transition: max-height 0.4s ease, opacity 0.3s ease;
    display: flex;
    flex-direction: column;
    z-index: 99;
    overflow: hidden;
    border-radius: 0 0 25px 25px;
    margin-top: -1px;
    /* Gap Fix */
  }

  .navbar.open .navbar-links {
    max-height: 500px;
    opacity: 1;
    padding-bottom: 20px;
  }

  /* --- THE UIVERSE DUAL-LINE ANIMATION --- */
  .nav-link {
    text-decoration: none;
    color: #333;
    font-size: 25px;
    font-weight: 600;
    padding: 15px 40px;
    display: block;
    width: fit-content;
    position: relative;
    opacity: 0;
    transform: translateX(-100%);
    transition: transform 0.5s var(--anim--hover-ease), opacity 0.5s ease;
  }

  .nav-link::before {
    content: '';
    width: 0%;
    height: 2px;
    background: var(--line-color);
    display: block;
    transition: 0.5s;
    margin-left: auto;
  }

  .nav-link::after {
    content: '';
    width: 0%;
    height: 2px;
    background: var(--line-color);
    display: block;
    transition: 0.5s;
    margin-top: 4px;
  }

  .nav-link:hover::after,
  .nav-link:hover::before {
    width: 100%;
  }

  /* --- DESKTOP NUDGE --- */
  .navbar.open .nav-link {
    opacity: 1;
    transform: translateX(0);
  }

  @media (min-width: 1025px) {
    .navbar.open .nav-link {
      transform: translateX(50px);
    }
  }

  /* Stagger Delays */
  .navbar.open .nav-link:nth-child(1) {
    transition-delay: 0.1s;
  }

  .navbar.open .nav-link:nth-child(2) {
    transition-delay: 0.2s;
  }

  .navbar.open .nav-link:nth-child(3) {
    transition-delay: 0.3s;
  }

  .navbar.open .nav-link:nth-child(4) {
    transition-delay: 0.4s;
  }
</style>

<nav class="navbar">
  <div class="hamburger"><span></span><span></span><span></span></div>
  <a href="/index/" class="nav-logo" onclick="handleNavigation(event, '/index/')">
    <img src="/assets/rideau-Logo.png" alt="Logo">
  </a>
  <div class="navbar-links">
    <a href="/homeDent/" class="nav-link" onclick="handleNavigation(event, '/index/')">Home</a>
    <a href="/about/" class="nav-link" onclick="handleNavigation(event, '/about/')">About</a>
    <a href="/faq/" class="nav-link" onclick="handleNavigation(event, '/faq/')">FAQ</a>
    <a href="/contact/" class="nav-link" onclick="handleNavigation(event, '/contact/')">Contact</a>
  </div>
</nav>

<script>
  const hamburger = document.querySelector('.hamburger');
  const navbar = document.querySelector('.navbar');
  hamburger.addEventListener('click', () => { navbar.classList.toggle('open'); });

  function handleNavigation(event, url) {
    event.preventDefault();
    const link = event.currentTarget;
    link.style.opacity = "0.7";
    setTimeout(() => { window.location.href = url; }, 450);
  }
</script>