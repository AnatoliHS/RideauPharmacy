<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{% if title and title != "Home" %}{{ title }} | {{ site.name }}{% else %}{{ site.name }} | {{ site.address.city }}, {{ site.address.regionName }}{% endif %}</title>

  <meta name="description" content="{{ site.description }}" />
  <meta name="author" content="{{ site.name }}" />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#0e2a24" />

  <meta property="og:title" content="{{ site.name }} | {{ site.address.city }}, {{ site.address.regionName }}" />
  <meta property="og:description" content="{{ site.description }}" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="{{ site.name }}" />
  {% if site.url %}<meta property="og:url" content="{{ site.url }}" />
  <meta property="og:image" content="{{ site.url }}/web/hero-poster.webp" />{% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Pharmacy",
    "name": {{ site.name | dump | safe }},
    {% if site.url %}"url": {{ site.url | dump | safe }},{% endif %}
    "description": {{ site.description | dump | safe }},
    "telephone": {{ site.phoneHref | dump | safe }},
    "faxNumber": {{ site.fax | dump | safe }},
    "address": {
      "@type": "PostalAddress",
      "streetAddress": {{ site.address.street | dump | safe }},
      "addressLocality": {{ site.address.city | dump | safe }},
      "addressRegion": {{ site.address.region | dump | safe }},
      "postalCode": {{ site.address.postal | dump | safe }},
      "addressCountry": {{ site.address.country | dump | safe }}
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": {{ site.geo.lat }},
      "longitude": {{ site.geo.lng }}
    },
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": {{ site.hours[0].open | dump | safe }},
        "closes": {{ site.hours[0].close | dump | safe }}
      }
    ]
  }
  </script>

  <script>document.documentElement.classList.add('js');</script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
  {# Only the old starter pages still rely on Startr's utility styles. #}
  {% if title != "Home" and title != "Privacy Policy" %}<link rel="stylesheet" href="https://startr.style/style.css" />{% endif %}

  <style>
    :root {
      --ivory: #f6f2ea;
      --ivory-deep: #ece6d9;
      --white: #fffdf9;
      --ink: #14241f;
      --muted: #5c6a64;
      --line: rgba(20, 36, 31, 0.14);
      --forest: #0e2a24;
      --forest-2: #163a32;
      --accent: #1a5a4b;
      --gold: #cdae7f;
      --gold-light: #e3cfae;
      --on-dark: #f6f2ea;
      --on-dark-muted: rgba(246, 242, 234, 0.72);
      --on-dark-line: rgba(246, 242, 234, 0.18);
      --font-sans: 'Instrument Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
      --font-serif: 'Instrument Serif', 'Times New Roman', serif;
      --font-display: var(--font-serif);
      --clr-text: var(--ink);
      --gutter: clamp(20px, 4.5vw, 72px);
      --section: clamp(88px, 11vw, 168px);
      --nav-h: 88px;
      --ease: cubic-bezier(0.16, 1, 0.3, 1);
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      -webkit-text-size-adjust: 100%;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: clip;
      background: var(--ivory);
      color: var(--ink);
      font-family: var(--font-sans);
      font-size: 18px;
      font-weight: 400;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    main {
      flex-grow: 1;
      width: 100%;
    }

    img,
    video,
    iframe {
      display: block;
      max-width: 100%;
    }

    h1,
    h2,
    h3,
    h4 {
      font-family: var(--font-serif);
      font-weight: 400;
      line-height: 1.04;
      letter-spacing: -0.015em;
      color: inherit;
    }

    em {
      font-style: italic;
    }

    [id] {
      scroll-margin-top: calc(var(--nav-h) + 16px);
    }

    :focus-visible {
      outline: 2px solid var(--gold);
      outline-offset: 3px;
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }

    .wrap {
      width: 100%;
      max-width: 1440px;
      margin-inline: auto;
      padding-inline: var(--gutter);
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 14px;
      color: inherit;
      text-decoration: none;
    }

    .brand-mark {
      width: 30px;
      height: 30px;
      flex-shrink: 0;
      fill: var(--gold);
    }

    .brand-text {
      display: flex;
      flex-direction: column;
      line-height: 1;
    }

    .brand-banner {
      margin-bottom: 4px;
      font-size: 0.64rem;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      opacity: 0.72;
    }

    .brand-name {
      font-family: var(--font-serif);
      font-size: 1.5rem;
      letter-spacing: -0.005em;
    }

    .coming-soon {
      flex: 1;
      padding: 10px;
      text-align: center;
    }
  </style>

  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="manifest" href="/site.webmanifest" />
</head>
