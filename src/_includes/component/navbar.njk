<style>
  :root {
    --nav-h: 76px;
    --menu-ease: cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    color: var(--ink);
    background: rgba(246, 242, 234, 0.92);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    transition: background-color 0.6s var(--ease), color 0.6s var(--ease);
  }

  .site-nav.is-overlay:not(.is-solid) {
    color: var(--on-dark);
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .site-nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: var(--nav-h);
  }

  .nav-brand {
    justify-self: start;
    color: inherit;
    font-family: var(--font-serif);
    font-size: 1.65rem;
    line-height: 1;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .nav-brand small {
    position: relative;
    display: block;
    width: max-content;
    margin-top: 4px;
    padding-bottom: 6px;
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  /* Guardian's red bar, as on the store sign, under "GUARDIAN PHARMACY" */
  .nav-brand small::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0.2em;
    bottom: 0;
    height: 3px;
    border-radius: 1px;
    background: var(--guardian-red);
  }

  .site-nav-links {
    display: flex;
    gap: 32px;
  }

  .site-nav-links a {
    color: inherit;
    font-size: 0.92rem;
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.3s ease;
  }

  .site-nav-links a:hover {
    opacity: 1;
  }

  .site-nav-end {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 18px;
  }

  .site-nav-cta {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 20px;
    border: 1px solid currentColor;
    border-radius: 999px;
    color: inherit;
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.4s var(--ease), color 0.4s var(--ease), border-color 0.4s var(--ease);
  }

  .site-nav-cta:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--ivory);
  }

  .site-nav.is-overlay:not(.is-solid) .site-nav-cta:hover {
    background: var(--on-dark);
    border-color: var(--on-dark);
    color: var(--forest);
  }

  .site-nav-toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.92rem;
    cursor: pointer;
  }

  /* Label rolls Menu → Close */
  .site-nav-label {
    display: block;
    height: 1.3em;
    line-height: 1.3em;
    overflow: hidden;
  }

  .site-nav-label > span {
    display: block;
    transition: transform 0.45s var(--menu-ease);
  }

  .site-nav.is-menu .site-nav-label > span {
    transform: translateY(-1.3em);
  }

  /* Two lines become an X */
  .site-nav-icon {
    position: relative;
    display: block;
    width: 22px;
    height: 12px;
  }

  .site-nav-icon::before,
  .site-nav-icon::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: currentColor;
    transition: transform 0.4s var(--menu-ease), top 0.4s var(--menu-ease);
  }

  .site-nav-icon::before {
    top: 3px;
  }

  .site-nav-icon::after {
    top: 8px;
  }

  .site-nav.is-menu .site-nav-icon::before {
    top: 5.5px;
    transform: rotate(45deg);
  }

  .site-nav.is-menu .site-nav-icon::after {
    top: 5.5px;
    transform: rotate(-45deg);
  }

  /* While the menu is open the bar sits clear on top of it, in light text */
  .site-nav.is-menu {
    color: var(--on-dark);
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .site-nav.is-menu .site-nav-links {
    visibility: hidden;
  }

  .site-nav.is-menu .site-nav-cta:hover {
    background: var(--on-dark);
    border-color: var(--on-dark);
    color: var(--forest);
  }

  html.nav-locked {
    overflow: hidden;
  }

  /* Menu: a photo on one half, the links on a deep green panel on the other */
  /* Revealed as a circle growing from the Menu button (its centre is set in --ox/--oy on open) */
  .site-drawer {
    --ox: calc(100% - 60px);
    --oy: 38px;
    position: fixed;
    inset: 0;
    z-index: 99;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    background: var(--forest-menu);
    color: var(--on-dark);
    visibility: hidden;
    clip-path: circle(0px at var(--ox) var(--oy));
    transition: clip-path 0.6s var(--menu-ease), visibility 0s linear 0.6s;
  }

  .site-drawer.is-open {
    visibility: visible;
    clip-path: circle(150vmax at var(--ox) var(--oy));
    transition: clip-path 0.75s var(--menu-ease), visibility 0s;
  }

  /* Photo panel: the orchid to start, then a photo matching the hovered link */
  .site-drawer-img {
    position: relative;
    overflow: hidden;
    background: var(--forest-menu);
    opacity: 0;
    transform: scale(1.08);
    transition: opacity 0.2s ease, transform 0.3s var(--menu-ease);
  }

  .site-drawer.is-open .site-drawer-img {
    opacity: 1;
    transform: none;
    transition: opacity 0.6s ease 0.2s, transform 1.2s var(--menu-ease) 0.2s;
  }

  .site-drawer-img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.06);
    transition: opacity 0.6s ease, transform 1.2s var(--menu-ease);
  }

  .site-drawer-img img.is-on {
    opacity: 1;
    transform: none;
  }

  /* Top fade keeps the logo readable where the bar sits over the photo */
  .site-drawer-img::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 30, 26, 0.7) 0%, rgba(10, 30, 26, 0) 22%);
  }

  .site-drawer-body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    min-width: 0;
    padding: calc(var(--nav-h) + 24px) var(--gutter) 36px;
    overflow-y: auto;
  }

  .site-drawer nav {
    display: grid;
    gap: 4px;
    margin-block: auto;
  }

  /* Each link rises out of its own masked line, one after another */
  .site-drawer-line {
    display: block;
    overflow: hidden;
  }

  .site-drawer nav a {
    display: inline-block;
    color: inherit;
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4.6vw, 3.8rem);
    line-height: 1.12;
    text-decoration: none;
    transform: translateY(105%);
    transition: transform 0.3s var(--menu-ease), color 0.4s ease, padding 0.6s var(--ease);
  }

  .site-drawer.is-open nav a {
    transform: none;
    transition: transform 0.7s var(--menu-ease) calc(0.12s + var(--i) * 0.04s), color 0.4s ease, padding 0.6s var(--ease);
  }

  .site-drawer nav a:hover {
    color: var(--gold-light);
    padding-left: 14px;
  }

  .site-drawer-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    color: var(--on-dark-muted);
    font-size: 0.92rem;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.2s ease, transform 0.3s var(--menu-ease);
  }

  .site-drawer.is-open .site-drawer-foot {
    opacity: 1;
    transform: none;
    transition: opacity 0.5s ease 0.35s, transform 0.6s var(--menu-ease) 0.35s;
  }

  .site-drawer-foot a {
    color: inherit;
    text-decoration: none;
  }

  .site-drawer-foot a:hover {
    color: var(--gold-light);
  }

  @media (max-width: 1000px) {
    .site-nav-inner {
      grid-template-columns: 1fr auto;
    }

    .site-nav-links {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-drawer,
    .site-drawer *,
    .site-nav-label > span,
    .site-nav-icon::before,
    .site-nav-icon::after {
      transition: none !important;
    }
  }

  @media (max-width: 640px) {
    .site-nav-cta {
      display: none;
    }

    .site-drawer {
      grid-template-columns: minmax(0, 1fr);
    }

    .site-drawer-img {
      display: none;
    }
  }
</style>

<nav class="site-nav{% if navOverlay %} is-overlay{% endif %}" aria-label="Main">
  <div class="wrap site-nav-inner">
    <a href="/" class="nav-brand" aria-label="{{ site.name }}, home">Bellfront<small>{{ site.banner }} Pharmacy</small></a>
    <div class="site-nav-links">
      <a href="/#services">Services</a>
      <a href="/#pharmacist">Your pharmacist</a>
      <a href="/#faq">Questions</a>
      <a href="/#visit">Visit</a>
    </div>
    <div class="site-nav-end">
      <a href="/#booking" class="site-nav-cta">Book appointment</a>
      <button class="site-nav-toggle" type="button" aria-expanded="false" aria-controls="site-drawer" aria-label="Menu"><span class="site-nav-label" aria-hidden="true"><span>Menu<br>Close</span></span><i class="site-nav-icon" aria-hidden="true"></i></button>
    </div>
  </div>
</nav>

<div class="site-drawer" id="site-drawer" inert>
  <div class="site-drawer-img" aria-hidden="true">
    <img data-src="/web/orchid.webp" alt="" class="is-on" style="object-position:50% 40%">
    <img data-src="/web/shelves.webp" alt="" style="object-position:50% 50%">
    <img data-src="/web/praful.webp" alt="" style="object-position:50% 25%">
    <img data-src="/web/consult-tablet.webp" alt="" style="object-position:50% 50%">
    <img data-src="/web/prescriptions-sign.webp" alt="" style="object-position:30% 50%">
    <img data-src="/web/consult-talk.webp" alt="" style="object-position:50% 30%">
    <img data-src="/web/storefront.webp" alt="" style="object-position:50% 50%">
  </div>
  <div class="site-drawer-body">
    <nav aria-label="Menu">
      <span class="site-drawer-line"><a href="/#services" style="--i:0" data-img="1">Services</a></span>
      <span class="site-drawer-line"><a href="/#pharmacist" style="--i:1" data-img="2">Your pharmacist</a></span>
      <span class="site-drawer-line"><a href="/#booking" style="--i:2" data-img="3">Book an appointment</a></span>
      <span class="site-drawer-line"><a href="{{ site.refillUrl }}" target="_blank" rel="noopener" style="--i:3" data-img="4">Refill a prescription</a></span>
      <span class="site-drawer-line"><a href="/#faq" style="--i:4" data-img="5">Questions</a></span>
      <span class="site-drawer-line"><a href="/#visit" style="--i:5" data-img="6">Hours &amp; directions</a></span>
    </nav>
    <div class="site-drawer-foot">
      <span>{{ site.address.street }}, {{ site.address.city }}</span>
      <a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a>
      <a href="{{ site.transferUrl }}" target="_blank" rel="noopener">Transfer a prescription</a>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.documentElement;
    var nav = document.querySelector('.site-nav');
    var toggle = document.querySelector('.site-nav-toggle');
    var drawer = document.getElementById('site-drawer');
    var hours = {{ site.hours | dump | safe }};
    var DAY_NAMES = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    var DAY_KEYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

    function toMinutes(hhmm) {
      var parts = hhmm.split(':');
      return Number(parts[0]) * 60 + Number(parts[1]);
    }

    function toLabel(hhmm) {
      var minutes = toMinutes(hhmm);
      var hour = Math.floor(minutes / 60);
      return ((hour % 12) || 12) + ':' + String(minutes % 60).padStart(2, '0') + (hour >= 12 ? ' PM' : ' AM');
    }

    function hoursFor(day) {
      return hours.filter(function (row) {
        return row.days.indexOf(day) !== -1 && row.open;
      })[0];
    }

    // Open or closed right now, on the pharmacy's clock. Used by the home page.
    function readStatus() {
      var parts = {};
      new Intl.DateTimeFormat('en-CA', {
        timeZone: 'America/Toronto',
        weekday: 'short',
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23'
      }).formatToParts(new Date()).forEach(function (part) {
        parts[part.type] = part.value;
      });

      var today = DAY_KEYS.indexOf(parts.weekday.slice(0, 3));
      var now = Number(parts.hour) * 60 + Number(parts.minute);
      var current = hoursFor(today);

      if (current && now >= toMinutes(current.open) && now < toMinutes(current.close)) {
        return { today: today, state: 'open', label: 'Open now', detail: 'Until ' + toLabel(current.close) + ' today' };
      }

      var status = { today: today, state: 'closed', label: 'Closed now', detail: '' };
      if (current && now < toMinutes(current.open)) {
        status.detail = 'Opens today at ' + toLabel(current.open);
        return status;
      }
      for (var offset = 1; offset <= 7; offset++) {
        var day = (today + offset) % 7;
        var next = hoursFor(day);
        if (next) {
          status.detail = 'Opens ' + (offset === 1 ? 'tomorrow' : DAY_NAMES[day]) + ' at ' + toLabel(next.open);
          break;
        }
      }
      return status;
    }

    window.siteStatus = readStatus;

    // Over the home hero the bar starts clear and turns solid as soon as the page scrolls.
    function updateSolid() {
      nav.classList.toggle('is-solid', window.scrollY > 4);
    }

    function menuOpen() {
      return drawer.classList.contains('is-open');
    }

    // The menu grows as a circle from the Menu button; the same button closes it.
    function setOpen(open) {
      if (open === menuOpen()) return;
      if (open) {
        var icon = toggle.querySelector('.site-nav-icon').getBoundingClientRect();
        drawer.style.setProperty('--ox', (icon.left + icon.width / 2) + 'px');
        drawer.style.setProperty('--oy', (icon.top + icon.height / 2) + 'px');
      }
      drawer.classList.toggle('is-open', open);
      nav.classList.toggle('is-menu', open);
      drawer.inert = !open;
      root.classList.toggle('nav-locked', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
    }

    toggle.addEventListener('click', function () { setOpen(!menuOpen()); });

    // Photo panel: orchid by default; hovering or focusing a link shows its photo.
    var photoPanel = drawer.querySelector('.site-drawer-img');
    var photos = Array.prototype.slice.call(photoPanel.querySelectorAll('img'));
    var menuNav = drawer.querySelector('nav');

    function showPhoto(index) {
      photos.forEach(function (img, k) { img.classList.toggle('is-on', k === index); });
    }

    // Photos load the first time the menu opens, and only where the panel is shown (not on phones).
    function loadPhotos() {
      if (getComputedStyle(photoPanel).display === 'none') return;
      photos.forEach(function (img) {
        if (img.dataset.src) {
          img.src = img.dataset.src;
          img.removeAttribute('data-src');
        }
      });
    }

    toggle.addEventListener('click', function () {
      if (menuOpen()) {
        loadPhotos();
        showPhoto(0);
      }
    });
    menuNav.querySelectorAll('a[data-img]').forEach(function (link) {
      var show = function () { showPhoto(Number(link.dataset.img)); };
      link.addEventListener('mouseenter', show);
      link.addEventListener('focus', show);
    });
    menuNav.addEventListener('mouseleave', function () { showPhoto(0); });
    drawer.addEventListener('click', function (event) {
      if (event.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && menuOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });
    window.addEventListener('scroll', updateSolid, { passive: true });
    window.addEventListener('resize', updateSolid);
    updateSolid();
    document.addEventListener('DOMContentLoaded', updateSolid);
  })();
</script>
